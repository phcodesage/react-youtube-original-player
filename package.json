{
  "name": "react-youtube-original-player",
  "version": "0.2.0",
  "description": "Original-language YouTube playback with automatic title/audio resolution, a Node HLS relay, and ReactPlayer controls.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcodesage/react-youtube-original-player.git"
  },
  "homepage": "https://github.com/phcodesage/react-youtube-original-player#readme",
  "bugs": { "url": "https://github.com/phcodesage/react-youtube-original-player/issues" },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "CONTRIBUTING.md", "docs", "examples"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./relay": { "types": "./dist/relay.d.ts", "import": "./dist/relay.js" }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:relay": "npm run build && node server/dev.mjs",
    "build": "tsup",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-player": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-player": "^3.4.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": { "node": ">=22.12.0" }
}
